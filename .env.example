# App
NODE_ENV=development
PORT=3000

# Database (points at the docker-compose `postgres` service by default)
DATABASE_URL=postgresql://aredc:aredc@localhost:5432/aredc?schema=public

# Separate DB used by the e2e test suite (docker-compose `postgres_test` service)
TEST_DATABASE_URL=postgresql://aredc:aredc@localhost:5433/aredc_test?schema=public

# JWT
JWT_SECRET=change-me-in-real-life-please
JWT_EXPIRES_IN=1d

# Seed users password (all seeded users share this password for the assessment)
SEED_USER_PASSWORD=Passw0rd!
