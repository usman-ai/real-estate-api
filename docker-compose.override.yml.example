# Copy this file to `docker-compose.override.yml` if the shipped ports (5432 for
# postgres, 5433 for postgres_test) collide with something already running on
# your host — for example a native Postgres install.
#
# The override file is git-ignored so your local remap won't be committed.
# Compose merges arrays by concatenation, so BOTH the shipped ports and these
# ports will be bound. If that's not what you want, use `!override` (compose
# spec) or edit the shipped file for your own use.
#
# If you change ports here, remember to also update DATABASE_URL and
# TEST_DATABASE_URL in your local .env accordingly.

services:
  postgres:
    ports:
      - "5442:5432"

  postgres_test:
    ports:
      - "5443:5432"
